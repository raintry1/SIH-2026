# Server port
PORT=3001

# Firebase Admin SDK service account
# Option A: path to a serviceAccountKey.json file (local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Option B: full JSON string of the service account (Render)
# FIREBASE_SERVICE_ACCOUNT={ "type": "service_account", ... }

# Allowed CORS origin(s), comma-separated
CORS_ORIGINS=http://localhost:5173

# Google OAuth Web Client ID (must match the one used by the frontend)
GOOGLE_CLIENT_ID=476115290827-snmunld87gppmff222ui13qnb5bvnffc.apps.googleusercontent.com

# Hybrid Analysis (Falcon Sandbox) - phishing URL check
# Create a public API key at https://www.hybrid-analysis.com -> My account -> API
HYBRIDANALYSIS_API_KEY=
# User ID from the Hybrid Analysis API key dashboard
HYBRIDANALYSIS_USER_ID=